# Copy to `.env` and fill in real keys. Never commit `.env`.
FIRECRAWL_API_KEY=fc-...

# One Reactive Resume key per profile. Suffix is the profile slug,
# uppercased, with hyphens turned into underscores.
# jane-doe → RXRESU_API_KEY_JANE_DOE
RXRESU_API_KEY_ABHISHEK=rr_...

# Fallback used only for the abhishek profile when RXRESU_API_KEY_ABHISHEK is unset.
RXRESU_API_KEY=rr_...
